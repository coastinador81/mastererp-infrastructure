# Uonify DEV · /etc/systemd/system/uonify-secrets.service
# Vuelca los secretos de SSM Parameter Store (/uonify/dev/run/*, /uonify/dev/edge/origin-verify)
# a tmpfs ANTES de que arranque Docker. Si falla (SSM inaccesible tras los reintentos o faltan
# google-oauth.json / encryption-key / postgres-password), docker.service NO arranca: falla cerrado.
#
# Refresco en caliente (sin reiniciar Docker ni contenedores): sudo /usr/local/sbin/uonify-secrets-sync
# OJO: «systemctl restart uonify-secrets» reinicia también docker.service (RequiredBy); con
# live-restore los contenedores siguen vivos, pero no hace falta: usa el comando de arriba.
#
# Sin ProtectSystem/ProtectHome/PrivateTmp/PrivateDevices ni ningún otro aislamiento de montajes:
# crearían un espacio de montaje propio y el tmpfs que monta el script no se vería en el host.

[Unit]
Description=Uonify DEV: secretos de SSM a tmpfs (/run/uonify, /run/uonify-db, /run/uonify-edge)
Wants=network-online.target
After=network-online.target
Before=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/uonify-secrets-sync
TimeoutStartSec=12min
Environment=HOME=/root
Environment=AWS_REGION=eu-west-1
Environment=AWS_DEFAULT_REGION=eu-west-1
Environment=AWS_PAGER=
Environment=AWS_CLI_AUTO_PROMPT=off
UMask=0077
NoNewPrivileges=yes
LockPersonality=yes
RestrictRealtime=yes
CapabilityBoundingSet=CAP_SYS_ADMIN CAP_CHOWN CAP_FOWNER CAP_DAC_OVERRIDE CAP_DAC_READ_SEARCH
SyslogIdentifier=uonify-secrets

[Install]
RequiredBy=docker.service

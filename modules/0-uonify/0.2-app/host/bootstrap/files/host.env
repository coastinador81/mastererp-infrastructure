# Uonify DEV · /etc/uonify/host.env (bootstrap.sh lo crea solo si no existe; root 0644).
# Valores NO secretos que leen los scripts del host. Nunca pongas aquí un secreto.
# Proyecto de Docker Compose y nombres de servicio (etiquetas com.docker.compose.*):
UONIFY_COMPOSE_PROJECT=uonify-dev
UONIFY_DB_SERVICE=db
UONIFY_NGINX_SERVICE=nginx
# Red de Docker a la que se une el contenedor efímero de pg_dump (vacío = la del contenedor db).
UONIFY_BACKUP_NETWORK=
# Copias nocturnas de PostgreSQL:
UONIFY_BACKUP_BUCKET=uonify-dev-backups-277352717693-eu-west-1
UONIFY_BACKUP_PREFIX=pg
# ARN de la CMK: salida KmsKeyArn del stack (no es secreto). Las subidas NO llevan cabeceras de cifrado
# (la política del bucket deniega pedir el alias); con esto relleno, la copia exige que S3 haya cifrado
# cada objeto con ESA clave. Lo rellena bootstrap.sh --kms-key-arn ARN. Vacío: comprueba aws:kms y una
# clave de la cuenta, sin fijar cuál.
UONIFY_KMS_KEY_ARN=
# Certificado del origen: runtime/compose.yaml monta /etc/letsencrypt/{live,archive}/origin-dev.uonify.com
# en nginx (maestro root). Solo si nginx corriera sin root (p. ej. nginx-unprivileged, uid 101), pon
# UONIFY_TLS_DIR=/etc/uonify/tls y el deploy hook dejará ahí una copia UID:GID 0440.
UONIFY_TLS_DIR=
UONIFY_TLS_UID=101
UONIFY_TLS_GID=0

# Variables of compose.yaml for the DEV host. Copy to /etc/uonify/compose.env (root:root 0600)
# and fill in; it holds no secrets (secrets are files under /run/uonify*, see compose.yaml).
# Every name must be present: compose stops with an error if one is missing.

# Own images in ECR (eu-west-1, repositories uonify-dev/api, uonify-dev/clips, uonify-dev/conv),
# by digest, as printed after the push of the REA-sealed overlays:
#   uonify-dev-api:devorigin-20261107    (Mac image id sha256:7e3743d0cbc9...)
#   uonify-dev-clips:devorigin-20261107  (Mac image id sha256:40562e4368bb...)
#   uonify-dev-conv:devorigin-20261107   (Mac image id sha256:1ba56906ee0d...)
# Format: sha256:<64 hex>. api, materials-worker and billing-worker share API_DIGEST.
API_DIGEST=sha256:REPLACE_WITH_ECR_DIGEST_OF_UONIFY_DEV_API
CLIPS_DIGEST=sha256:REPLACE_WITH_ECR_DIGEST_OF_UONIFY_DEV_CLIPS
CONV_DIGEST=sha256:REPLACE_WITH_ECR_DIGEST_OF_UONIFY_DEV_CONV

# Durable output of the clip engine: same values as the Mac stack (docker inspect
# uonify-local-api-1). Empty keeps the engine fail-closed (no generation can be stored).
UONIFY_CREATIVE_OUTPUT_BUCKETS=
UONIFY_CREATIVE_OUTPUT_LOCATION=

# Workspace project UUID(s) of the owner in the NEW DEV database, comma separated. Empty until
# he has created his project after the first login (the DB starts empty).
UONIFY_TEST_PROJECT_IDS=

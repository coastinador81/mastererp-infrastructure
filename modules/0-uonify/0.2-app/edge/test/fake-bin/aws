#!/usr/bin/env node
// Doble de prueba del AWS CLI para test_gate.mjs: NUNCA llama a AWS. Emula, contra un fichero JSON
// local, solo las llamadas que hacen set_gate_credentials.sh, run_test_function.mjs y
// deploy_edge.mjs. Cualquier otra llamada falla (Unsupported), y también las que olvidan la región
// donde la AWS CLI real la exige (KeyValueStore → us-east-1, SSM → eu-west-1, S3 → us-east-1).
//   FAKE_KVS_STATE   fichero JSON con el estado (KVS, funciones, distribución, SSM, S3)
//   FAKE_AWS_LOG     fichero donde se añade el argv de cada llamada (para comprobar que ningún
//                    secreto viaja como argumento)
//   FAKE_AWS_CONFLICT_ONCE=1   la primera update-keys falla por ETag (prueba de reintento)
//   FAKE_AWS_KVS_DATA_FAIL=X   el API de datos del KVS falla con el código X (antes de pedir nada)
//   FAKE_AWS_DIST_CONFLICT=1   update-distribution falla por ETag (otro cambio se adelantó)
//   FAKE_AWS_ECHO_SECRET=1     los errores de update-distribution repiten la cabecera de origen
//                              (para probar que deploy_edge.mjs la tapa)
const fs = require('node:fs');
const path = require('node:path');
const crypto = require('node:crypto');

const argv = process.argv.slice(2);
const statePath = process.env.FAKE_KVS_STATE;
const logPath = process.env.FAKE_AWS_LOG;
if (logPath) fs.appendFileSync(logPath, JSON.stringify(argv) + '\n');
const load = () => JSON.parse(fs.readFileSync(statePath, 'utf8'));
const save = (s) => fs.writeFileSync(statePath, JSON.stringify(s));
const opt = (name) => {
  const i = argv.indexOf(name);
  return i >= 0 ? argv[i + 1] : undefined;
};
const has = (name) => argv.includes(name);
const fail = (code, message) => {
  process.stderr.write(`\nAn error occurred (${code}) when calling the operation: ${message}\n`);
  process.exit(254);
};
const out = (value) => process.stdout.write((typeof value === 'string' ? value : JSON.stringify(value)) + '\n');
const fileArg = (value, prefix) => {
  if (!value || !value.startsWith(prefix)) fail('Unsupported', `se esperaba ${prefix}`);
  return value.slice(prefix.length);
};
const needRegion = (region) => {
  if (opt('--region') !== region) fail('NoRegion', `You must specify a region (${region})`);
};
const etag = () => 'E' + crypto.randomBytes(6).toString('hex').toUpperCase();

const ACCOUNT = '277352717693';
const KVS_ARN = 'arn:aws:cloudfront::123456789012:key-value-store/00000000-1111-2222-3333-444444444444';
const DIST_ID = 'E4N1UCPZZ2F0';
const BUCKET = 'uonify-dev-web-277352717693';
const REDACTION = /__REDACTED__|«|»/;
const MANAGED_CACHE = [['Managed-CachingOptimized', '658327ea-f89d-4fab-a63d-7e88639e58f6'], ['Managed-CachingDisabled', '4135ea2d-6df8-44a3-9df3-4b5a84be39ad']];
const MANAGED_ORIGIN = [['Managed-AllViewer', '216adef6-5c7f-47e4-b989-5492eafa07d3'], ['Managed-AllViewerExceptHostHeader', 'b689b0a8-53d0-40ab-baf2-68738e2966ac'], ['Managed-CORS-S3Origin', '88a5eaf4-2fd4-4709-b370-b4c650ea3fcf']];
const service = argv[0];
const op = argv[1];
const state = load();
state.functions = state.functions || {};
const fnArn = (name) => `arn:aws:cloudfront::${state.account || ACCOUNT}:function/${name}`;

// Regla de CloudFront: toda lista {Quantity, Items} debe cuadrar.
function checkQuantities(node, where) {
  if (Array.isArray(node)) return node.forEach((child, i) => checkQuantities(child, `${where}[${i}]`));
  if (!node || typeof node !== 'object') return;
  if ('Quantity' in node) {
    const n = (node.Items || []).length;
    if (node.Quantity !== n) fail('InvalidArgument', `${where}: Quantity ${node.Quantity} y ${n} Items`);
  }
  for (const [k, v] of Object.entries(node)) checkQuantities(v, `${where}.${k}`);
}

function checkDistribution(cfg) {
  checkQuantities(cfg, 'DistributionConfig');
  const origins = new Set(cfg.Origins.Items.map((o) => o.Id));
  const behaviors = [cfg.DefaultCacheBehavior, ...((cfg.CacheBehaviors && cfg.CacheBehaviors.Items) || [])];
  for (const b of behaviors) {
    if (!origins.has(b.TargetOriginId)) fail('NoSuchOrigin', b.TargetOriginId);
    if (b.CachePolicyId && (b.ForwardedValues || b.MinTTL !== undefined)) fail('InvalidArgument', 'CachePolicyId con ForwardedValues/TTL');
    if (b.ResponseHeadersPolicyId && !(state.headersPolicies || {})[b.ResponseHeadersPolicyId]) fail('NoSuchResponseHeadersPolicy', b.ResponseHeadersPolicyId);
    for (const a of (b.FunctionAssociations && b.FunctionAssociations.Items) || []) {
      const name = a.FunctionARN.split('function/')[1];
      if (!state.functions[name] || !state.functions[name].LIVE) fail('InvalidArgument', `la función ${name} no está publicada en LIVE`);
    }
  }
  for (const o of cfg.Origins.Items) {
    for (const h of (o.CustomHeaders && o.CustomHeaders.Items) || []) {
      if (REDACTION.test(h.HeaderValue) || !h.HeaderValue || h.HeaderValue.length > 1783) fail('InvalidArgument', `HeaderValue no válido en ${o.Id}`);
    }
  }
}

function functionSummary(name, stage) {
  const f = state.functions[name] && state.functions[name][stage];
  if (!f) fail('NoSuchFunctionExists', `${name} (${stage})`);
  return { ETag: f.etag, FunctionSummary: { Name: name, Status: 'UNASSOCIATED', FunctionConfig: f.config, FunctionMetadata: { FunctionARN: fnArn(name), Stage: stage, LastModifiedTime: '2026-11-07T00:00:00Z' } } };
}

function readFunctionInput() {
  const config = JSON.parse(opt('--function-config'));
  const code = fs.readFileSync(fileArg(opt('--function-code'), 'fileb://'));
  if (config.Runtime !== 'cloudfront-js-2.0') fail('InvalidArgument', 'Runtime');
  const kvs = config.KeyValueStoreAssociations;
  if (!kvs || kvs.Quantity !== 1 || kvs.Items[0].KeyValueStoreARN !== KVS_ARN) fail('InvalidArgument', 'KeyValueStoreAssociations');
  if (code.length > 10240) fail('FunctionSizeLimitExceeded', String(code.length));
  return { config, code: code.toString('base64') };
}

function runFunction() {
  // Ejecuta localmente la función (como test-function) con el KVS del fichero de estado.
  const name = opt('--name');
  const stage = opt('--stage') || 'DEVELOPMENT';
  const stored = state.functions[name] && state.functions[name][stage];
  if (opt('--if-match') !== (stored ? stored.etag : 'ETAG-FN')) fail('PreconditionFailed', 'etag');
  const source = stored ? Buffer.from(stored.code, 'base64').toString('utf8')
    : fs.readFileSync(path.join(__dirname, '..', '..', /api/.test(name) ? 'gate-api.js' : 'gate-default.js'), 'utf8');
  const body = source.replace(/^import cf from 'cloudfront';\s*$/m, '').replace(/^import crypto from 'crypto';\s*$/m, '');
  const cf = { kvs: () => ({ get: async (k) => { if (!(k in state.items)) throw new Error('KeyNotFound'); return state.items[k]; } }) };
  const handler = new Function('cf', 'crypto', 'atob', '"use strict";\n' + body + '\nreturn handler;')(cf, crypto, globalThis.atob);
  const event = JSON.parse(fs.readFileSync(fileArg(opt('--event-object'), 'fileb://'), 'utf8'));
  handler(event).then((res) => {
    const output = res.statusCode !== undefined ? { response: res } : { request: res };
    out({ TestResult: { ComputeUtilization: '9', FunctionErrorMessage: '', FunctionExecutionLogs: [], FunctionOutput: JSON.stringify(output) } });
  });
}

if (service === 'sts' && op === 'get-caller-identity') {
  out({ UserId: 'AIDAPRUEBA', Account: state.account || ACCOUNT, Arn: `arn:aws:iam::${state.account || ACCOUNT}:user/operador-de-prueba` });
} else if (service === 'cloudfront' && op === 'describe-function') {
  const summary = functionSummary(opt('--name'), opt('--stage') || 'DEVELOPMENT');
  out(opt('--query') === 'ETag' ? summary.ETag : summary);
} else if (service === 'cloudfront' && op === 'get-function') {
  const name = opt('--name');
  const stage = opt('--stage') || 'LIVE';
  const f = state.functions[name] && state.functions[name][stage];
  if (!f) fail('NoSuchFunctionExists', `${name} (${stage})`);
  fs.writeFileSync(argv[argv.length - 1], Buffer.from(f.code, 'base64'));
  out({ ETag: f.etag, ContentType: 'application/octet-stream' });
} else if (service === 'cloudfront' && op === 'create-function') {
  const name = opt('--name');
  if (state.functions[name]) fail('FunctionAlreadyExists', name);
  state.functions[name] = { DEVELOPMENT: { ...readFunctionInput(), etag: etag() } };
  save(state);
  out(functionSummary(name, 'DEVELOPMENT'));
} else if (service === 'cloudfront' && op === 'update-function') {
  const name = opt('--name');
  const dev = state.functions[name] && state.functions[name].DEVELOPMENT;
  if (!dev) fail('NoSuchFunctionExists', name);
  if (opt('--if-match') !== dev.etag) fail('PreconditionFailed', 'etag');
  state.functions[name].DEVELOPMENT = { ...readFunctionInput(), etag: etag() };
  save(state);
  out(functionSummary(name, 'DEVELOPMENT'));
} else if (service === 'cloudfront' && op === 'publish-function') {
  const name = opt('--name');
  const dev = state.functions[name] && state.functions[name].DEVELOPMENT;
  if (!dev) fail('NoSuchFunctionExists', name);
  if (opt('--if-match') !== dev.etag) fail('PreconditionFailed', 'etag');
  state.functions[name].LIVE = { ...dev, etag: etag() };
  state.published = (state.published || []).concat([name]);
  save(state);
  out(functionSummary(name, 'LIVE'));
} else if (service === 'cloudfront' && op === 'test-function') {
  runFunction();
} else if (service === 'cloudfront' && op === 'describe-key-value-store') {
  if (state.kvsMissing || opt('--name') !== 'uonify-dev-gate') fail('EntityNotFound', 'no such kvs');
  const status = state.status || 'READY';
  if (status === 'PROVISIONING') {
    state.status = 'READY';
    save(state);
  }
  const query = opt('--query');
  if (query === 'KeyValueStore.Status') out(status);
  else if (query === 'KeyValueStore.ARN') out(KVS_ARN);
  else if (query === undefined) out({ ETag: 'E-KVS', KeyValueStore: { Name: 'uonify-dev-gate', Id: '00000000-1111-2222-3333-444444444444', Comment: '', ARN: KVS_ARN, Status: status } });
  else fail('Unsupported', 'query');
} else if (service === 'cloudfront' && op === 'create-key-value-store') {
  if (!state.kvsMissing) fail('EntityAlreadyExists', opt('--name'));
  if (opt('--name') !== 'uonify-dev-gate') fail('Unsupported', 'nombre');
  state.kvsMissing = false;
  state.status = 'PROVISIONING';
  state.items = state.items || {};
  state.etag = state.etag || 'ETAG-0';
  save(state);
  out({ ETag: 'E-KVS', KeyValueStore: { Name: 'uonify-dev-gate', ARN: KVS_ARN, Status: 'PROVISIONING' } });
} else if (service === 'cloudfront-keyvaluestore') {
  needRegion('us-east-1');
  if (process.env.FAKE_AWS_KVS_DATA_FAIL) fail(process.env.FAKE_AWS_KVS_DATA_FAIL, 'data plane');
  if (state.kvsMissing || opt('--kvs-arn') !== KVS_ARN) fail('ResourceNotFoundException', 'arn');
  if (op === 'describe-key-value-store') {
    out(opt('--query') === 'ETag' ? state.etag : { ETag: state.etag, ItemCount: Object.keys(state.items).length, KvsARN: KVS_ARN });
  } else if (op === 'update-keys') {
    if (process.env.FAKE_AWS_CONFLICT_ONCE === '1' && !state.conflicted) {
      state.conflicted = true;
      state.etag = 'ETAG-' + Math.random().toString(16).slice(2);
      save(state);
      fail('ConflictException', 'etag changed');
    }
    if (opt('--if-match') !== state.etag) fail('ValidationException', 'if-match');
    const file = fileArg(opt('--puts') || '', 'file://');
    const mode = fs.statSync(file).mode & 0o777;
    state.putsFiles = (state.putsFiles || []).concat([{ path: file, mode }]);
    for (const item of JSON.parse(fs.readFileSync(file, 'utf8'))) state.items[item.Key] = item.Value;
    state.etag = 'ETAG-' + Math.random().toString(16).slice(2);
    save(state);
    out({ ETag: state.etag, ItemCount: Object.keys(state.items).length });
  } else if (op === 'get-key') {
    const key = opt('--key');
    if (!(key in state.items)) fail('ResourceNotFoundException', 'key');
    out(state.items[key]);
  } else if (op === 'list-keys') {
    if (opt('--query') !== 'Items[].Key') fail('Unsupported', 'list-keys solo con --query Items[].Key (nunca los valores)');
    out(opt('--output') === 'json' ? Object.keys(state.items) : Object.keys(state.items).join('\t'));
  } else fail('Unsupported', op);
} else if (service === 'cloudfront' && op === 'get-distribution-config') {
  if (opt('--id') !== DIST_ID || !state.distribution) fail('NoSuchDistribution', String(opt('--id')));
  const query = opt('--query');
  if (query === 'ETag') out(state.distribution.etag);
  else if (query === undefined) out({ ETag: state.distribution.etag, DistributionConfig: state.distribution.config });
  else fail('Unsupported', 'query');
} else if (service === 'cloudfront' && op === 'update-distribution') {
  if (opt('--id') !== DIST_ID || !state.distribution) fail('NoSuchDistribution', String(opt('--id')));
  const file = fileArg(opt('--distribution-config'), 'file://');
  const mode = fs.statSync(file).mode & 0o777;
  const dirMode = fs.statSync(path.dirname(file)).mode & 0o777;
  state.configFiles = (state.configFiles || []).concat([{ path: file, mode, dirMode }]);
  save(state);
  const cfg = JSON.parse(fs.readFileSync(file, 'utf8'));
  if (process.env.FAKE_AWS_ECHO_SECRET === '1') {
    const values = cfg.Origins.Items.flatMap((o) => ((o.CustomHeaders && o.CustomHeaders.Items) || []).map((h) => h.HeaderValue));
    fail('InvalidArgument', `The parameter HeaderValue ${values.join(' ')} is invalid`);
  }
  if (process.env.FAKE_AWS_DIST_CONFLICT === '1' || opt('--if-match') !== state.distribution.etag) fail('PreconditionFailed', 'The If-Match version is missing or not valid for the resource.');
  checkDistribution(cfg);
  state.distribution = { etag: etag(), config: cfg };
  state.distributionUpdates = (state.distributionUpdates || 0) + 1;
  save(state);
  out(opt('--query') === 'Distribution.Status' ? 'InProgress' : { ETag: state.distribution.etag, Distribution: { Id: DIST_ID, Status: 'InProgress', DistributionConfig: cfg } });
} else if (service === 'cloudfront' && op === 'wait' && argv[2] === 'distribution-deployed') {
  if (argv[argv.indexOf('--id') + 1] !== DIST_ID) fail('NoSuchDistribution', 'id');
} else if (service === 'cloudfront' && op === 'list-cache-policies') {
  if (opt('--type') !== 'managed') fail('Unsupported', 'type');
  out({ CachePolicyList: { Items: MANAGED_CACHE.map(([Name, Id]) => ({ Type: 'managed', CachePolicy: { Id, CachePolicyConfig: { Name } } })) } });
} else if (service === 'cloudfront' && op === 'list-origin-request-policies') {
  if (opt('--type') !== 'managed') fail('Unsupported', 'type');
  out({ OriginRequestPolicyList: { Items: MANAGED_ORIGIN.map(([Name, Id]) => ({ Type: 'managed', OriginRequestPolicy: { Id, OriginRequestPolicyConfig: { Name } } })) } });
} else if (service === 'cloudfront' && op === 'list-response-headers-policies') {
  if (opt('--type') !== 'custom') fail('Unsupported', 'type');
  const list = Object.values(state.headersPolicies || {});
  out({ ResponseHeadersPolicyList: { MaxItems: 100, Quantity: list.length, Items: list.map((p) => ({ Type: 'custom', ResponseHeadersPolicy: p })) } });
} else if (service === 'cloudfront' && op === 'create-response-headers-policy') {
  const cfg = JSON.parse(fs.readFileSync(fileArg(opt('--response-headers-policy-config'), 'file://'), 'utf8'));
  checkQuantities(cfg, 'ResponseHeadersPolicyConfig');
  state.headersPolicies = state.headersPolicies || {};
  if (!cfg.Name) fail('InvalidArgument', 'Name');
  if (Object.values(state.headersPolicies).some((p) => p.ResponseHeadersPolicyConfig.Name === cfg.Name)) fail('ResponseHeadersPolicyAlreadyExists', cfg.Name);
  const sts = cfg.SecurityHeadersConfig && cfg.SecurityHeadersConfig.StrictTransportSecurity;
  if (sts && (typeof sts.AccessControlMaxAgeSec !== 'number' || typeof sts.Override !== 'boolean')) fail('InvalidArgument', 'StrictTransportSecurity');
  const id = crypto.randomUUID();
  state.headersPolicies[id] = { Id: id, LastModifiedTime: '2026-11-08T00:00:00Z', ResponseHeadersPolicyConfig: cfg };
  save(state);
  out({ ETag: etag(), ResponseHeadersPolicy: state.headersPolicies[id] });
} else if (service === 'ssm' && (op === 'describe-parameters' || op === 'get-parameter')) {
  needRegion('eu-west-1');
  const ssm = state.ssm || {};
  if (op === 'describe-parameters') {
    const filter = opt('--parameter-filters') || '';
    const name = (/^Key=Name,Values=(.+)$/.exec(filter) || [])[1];
    const p = name && ssm[name];
    out({ Parameters: p ? [{ Name: name, Type: p.Type, Version: p.Version, KeyId: 'alias/uonify-dev' }] : [] });
  } else {
    const name = opt('--name');
    const p = ssm[name];
    if (!p) fail('ParameterNotFound', name);
    if (!has('--with-decryption')) fail('Unsupported', 'sin --with-decryption');
    out({ Parameter: { Name: name, Type: p.Type, Value: p.Value, Version: p.Version, ARN: `arn:aws:ssm:eu-west-1:${ACCOUNT}:parameter${name}`, DataType: 'text' } });
  }
} else if (service === 's3api' && (op === 'head-object' || op === 'put-object')) {
  needRegion('us-east-1');
  if (opt('--bucket') !== BUCKET) fail('AccessDenied', 'bucket');
  const key = opt('--key');
  state.s3 = state.s3 || {};
  if (op === 'head-object') {
    const o = state.s3[key];
    if (!o) fail('404', 'Not Found');
    out({ ContentLength: Buffer.from(o.body, 'base64').length, ContentType: o.ContentType, CacheControl: o.CacheControl, ChecksumSHA256: has('--checksum-mode') ? o.ChecksumSHA256 : undefined });
  } else {
    const body = fs.readFileSync(opt('--body'));
    if (opt('--checksum-algorithm') !== 'SHA256') fail('Unsupported', 'checksum');
    const sum = crypto.createHash('sha256').update(body).digest('base64');
    state.s3[key] = { body: body.toString('base64'), ContentType: opt('--content-type'), CacheControl: opt('--cache-control'), ChecksumSHA256: sum };
    save(state);
    out({ ETag: '"' + crypto.createHash('md5').update(body).digest('hex') + '"', ChecksumSHA256: sum });
  }
} else {
  fail('Unsupported', service + ' ' + op);
}
